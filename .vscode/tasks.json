{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev: extension + webview (pixel-agent)",
      "dependsOn": [
        "npm: watch (pixel-agent)",
        "npm: dev:webview (pixel-agent)"
      ],
      "dependsOrder": "parallel"
    },
    {
      "type": "npm",
      "script": "watch",
      "path": "vscode-pixel-agent-extension",
      "label": "npm: watch (pixel-agent)",
      "isBackground": true,
      "problemMatcher": [
        "$tsc-watch"
      ],
      "group": "build"
    },
    {
      "type": "npm",
      "script": "dev:webview",
      "path": "vscode-pixel-agent-extension",
      "label": "npm: dev:webview (pixel-agent)",
      "isBackground": true,
      "problemMatcher": [
        {
          "owner": "custom",
          "pattern": [
            {
              "regexp": "^(ERROR.*)$",
              "message": 1
            }
          ],
          "background": {
            "activeOnStart": true,
            "beginsPattern": ".",
            "endsPattern": "ready in|Local:"
          }
        }
      ],
      "group": "build"
    },
    {
      "type": "npm",
      "script": "build",
      "path": "vscode-pixel-agent-extension",
      "label": "npm: build (pixel-agent)",
      "problemMatcher": ["$tsc"],
      "group": "build"
    }
  ]
}
