{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Pixel Agent Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/vscode-pixel-agent-extension"
      ],
      "outFiles": [
        "${workspaceFolder}/vscode-pixel-agent-extension/dist/**/*.js"
      ],
      "preLaunchTask": "dev: extension + webview (pixel-agent)"
    }
  ]
}
