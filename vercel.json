{
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev:web",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "destination": "https://www.budio.nl/:path*",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "budio.nl"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    }
  ]
}
