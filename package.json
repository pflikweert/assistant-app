{
  "name": "budio",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "dev": "npm run migrations:check && supabase db push && node ./scripts/dev.mjs",
    "dev:api": "node --experimental-strip-types ./scripts/dev-api-server.mjs",
    "dev:web": "node ./scripts/dev-web.mjs",
  "build": "expo export --platform web",
  "test:unit": "vitest run",
  "test:help-assistant-eval": "RUN_LIVE_HELP_ASSISTANT_EVAL=1 vitest run services/help-assistant-live-eval.test.ts",
  "help-assistant:list-merchants": "node ./scripts/help-assistant-list-merchants.cjs",
  "help-assistant:search-categories": "node ./scripts/help-assistant-search-category-catalog.cjs",
  "migrations:check": "node ./scripts/check-migrations.mjs",
    "migration:new": "node ./scripts/new-migration.mjs",
    "db:push": "npm run migrations:check && supabase db push",
    "db:push:dry": "npm run migrations:check && supabase db push --dry-run",
    "backfill:tenant-owner": "node ./scripts/backfill-multi-tenant-owner.js",
    "reset-project": "node ./scripts/reset-project.js",
    "design:forbidden-hex": "node ./scripts/design-forbidden-hex.mjs",
    "design:forbidden-hex:baseline": "node ./scripts/design-forbidden-hex.mjs --write-baseline",
    "design:style-literals": "node ./scripts/design-style-literals-check.mjs",
    "design:style-literals:baseline": "node ./scripts/design-style-literals-check.mjs --write-baseline",
    "design:touchables": "node ./scripts/design-touchables-check.mjs",
    "design:touchables:baseline": "node ./scripts/design-touchables-check.mjs --write-baseline",
    "design:inventory": "node ./scripts/design-route-inventory-check.mjs",
    "design:shells": "node ./scripts/design-shell-pattern-check.mjs",
    "design:screen-patterns": "node ./scripts/design-screen-pattern-check.mjs",
    "design:report": "node ./scripts/design-compliance-report.mjs",
    "design:check": "npm run design:forbidden-hex && npm run design:style-literals && npm run design:touchables && npm run design:inventory && npm run design:shells && npm run design:screen-patterns && npm run design:report",
    "stitch:codex:setup": "node ./scripts/stitch-codex-setup.mjs",
    "stitch:tool": "node ./scripts/stitch-tool.mjs",
    "stitch:tools:list": "node ./scripts/stitch-tool.mjs -s",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint ."
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@shopify/react-native-skia": "^2.2.12",
    "@supabase/supabase-js": "^2.99.1",
    "@vercel/analytics": "1.5.0",
    "@vercel/speed-insights": "1.2.0",
    "dotenv": "^17.3.1",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.8",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.10",
    "fflate": "^0.8.2",
    "openai": "^6.27.0",
    "papaparse": "^5.5.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/react": "~19.1.0",
    "@types/react-native": "^0.72.8",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "react-native-svg-transformer": "^1.5.3",
    "react-test-renderer": "^19.1.0",
    "typescript": "~5.9.2",
    "vercel": "^50.37.0",
    "vitest": "^3.2.4"
  },
  "private": true
}
