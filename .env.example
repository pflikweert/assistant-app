# Copy this file to .env and fill in your own values
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
OPENAI_API_KEY=your-openai-api-key
# Optional, needed for live organization usage/cost queries in Budio beheer.
# This must be an OpenAI admin key with usage read access; a regular OPENAI_API_KEY is not enough.
OPENAI_ADMIN_KEY=your-openai-admin-key
APP_BASE_URL=http://localhost:3001
SITE_URL=http://localhost:3001
EXPO_PUBLIC_IMPORT_DEBUG=false

# In production, set APP_BASE_URL to your public site URL, for example:
# APP_BASE_URL=https://budio.nl

# In production, set the auth/site URL to your public site URL, for example:
# SITE_URL=https://budio.nl
# EXPO_PUBLIC_SITE_URL=https://budio.nl

# Backend only. Never expose these in the client and never prefix them with EXPO_PUBLIC_.
# Use these for API routes, scripts, workers, migrations and other privileged flows.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_SECRET_KEY=your-supabase-secret-key
GITHUB_TOKEN=your-github-token-with-issues-write
GITHUB_OWNER=your-github-owner
# GITHUB_REPO can be either just the repository name or owner/repo.
GITHUB_REPO=your-github-repository

# Optional CLI / database access for remote repair and db push.
SUPABASE_ACCESS_TOKEN=your-supabase-access-token
SUPABASE_DB_PASSWORD=your-remote-database-password
SUPABASE_DB_URL=postgresql://postgres.project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:5432/postgres
